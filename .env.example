# ScamTrace API Configuration
# Copy this file to .env.local and fill in your API keys

# ============================================================================
# REQUIRED FOR FULL FUNCTIONALITY
# ============================================================================

# Supabase (for auth and database)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================================
# OPTIONAL - FREE TIER APIS (Enhanced functionality)
# ============================================================================

# Etherscan API Key (free: 5 calls/sec, 100k calls/day)
# Get one at: https://etherscan.io/apis
VITE_ETHERSCAN_KEY=YourApiKeyToken

# IP Info Token (free: 50k req/month)
# Get one at: https://ipinfo.io/signup
VITE_IPINFO_KEY=

# AbuseIPDB API Key (free: 1000 checks/day)
# Get one at: https://www.abuseipdb.com/api
VITE_ABUSEIPDB_KEY=

# VirusTotal API Key (free: 4 req/min)
# Get one at: https://www.virustotal.com/gui/my-apikey
VITE_VIRUSTOTAL_KEY=

# NumVerify API Key (free: 100 req/month)
# Get one at: https://numverify.com/dashboard
VITE_NUMVERIFY_KEY=

# Stripe (for payments)
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# ============================================================================
# FREE APIS USED (NO KEY REQUIRED)
# ============================================================================
# - Blockstream API (Bitcoin blockchain data)
# - ipapi.co (IP geolocation - 1000 req/day)
# - URLhaus (malware URL database)
# - RDAP (domain WHOIS data)
# - Google DNS-over-HTTPS (DNS lookups)
